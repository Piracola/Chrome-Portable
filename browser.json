        "channel": "win_stable_x64",
        "request": {
          "os": "platform=\"win\" version=\"10.0.26100.1742\" arch=\"arm64\"",
          "app": "version=\"\" appid=\"{8A69D345-D564-463C-AFF1-A69D9E530F96}\" ap=\"arm64-stable\""
        }
      },
      "version_root": "Chrome-bin",
      "layout": "move_version_root",
      "chrome_plus_dir": "chrome++",
      "ini_location": "app_root",
      "version_dll_location": "app_root",
      "forbidden_file_names": [
